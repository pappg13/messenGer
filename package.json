{
  "name": "vibecoding",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {},
  "type": "module",
  "scripts": {
    "start": "live-server",
    "build": "rm -rf docs && mkdir -p docs && cp -R index.html login.html style.css firebase.js auth.js manifest.json favicon.ico js lib docs/",
    "deploy": "gh-pages -d docs",
    "emulators": "firebase emulators:start --only auth,database,storage,functions",
    "test": "firebase emulators:exec --only auth,database,storage --project messen-g-er2 \"npm --prefix functions test\""
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "dotenv": "^16.5.0",
    "firebase": "^9.15.0",
    "firebase-functions": "^6.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "live-server": "^1.2.0",
    "openai": "^4.103.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  },
  "description": "voice messaging app",
  "main": "js/app.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pappg13/messenGer.git"
  },
